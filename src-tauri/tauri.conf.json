{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NVRBEATS",
  "version": "0.1.0",
  "identifier": "app.djsetrecorder.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "bun run desktop:web",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "NVRBEATS",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "dj-set-recorder-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "NVRBEATS"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
